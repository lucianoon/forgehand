# Copy to a protected file OUTSIDE the checkout, then replace all placeholders.
# Read with: docker compose --env-file /etc/forgehand/team.env -f docker-compose.team.yml ...
TEAM_ENV_FILE=/etc/forgehand/team.env
FORGEHAND_IMAGE=forgehand:REVIEWED_COMMIT_SHA
FORGEHAND_REVISION=REVIEWED_40_CHARACTER_COMMIT_SHA
FORGEHAND_DATA_ROOT=/srv/forgehand-data
# Nonzero IDs; prepare the host data root with these numeric owners.
FORGEHAND_UID=1000
FORGEHAND_GID=1000
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_SOCKET_GID=REPLACE_WITH_SOCKET_GROUP_ID
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
INSTALLATION_EXPECTED_WORKERS=2

# PostgreSQL 16 only on the Compose network. Use a long random URL-safe password;
# if it includes reserved URI characters, percent-encode it in DATABASE_URL.
POSTGRES_IMAGE=postgres:16.15-bookworm
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://forgehand:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/forgehand

# Distinct non-demo keys per person/service, limited to the team's project.
# Replace the entire placeholder; "viewer", "operator", "approver", "admin".
API_KEYS_JSON='{"REPLACE_WITH_RANDOM_ADMIN_KEY":{"client_id":"team-admin","projects":["team-project"],"role":"admin"}}'

# One configured backend shared by API and workers. No model call occurs at boot.
LLM_PROVIDER_BACKEND=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional reviewed model/pricing overrides can be added as ordinary env values:
# TIER_BINDINGS_JSON=...
# JUDGE_TIER_BINDINGS_JSON=...
# PRICING_JSON=...

# GitHub App takes precedence when all three fields are populated.
# Store PEM with literal \n separators inside single quotes, never in a repository.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=''
GITHUB_TOKEN=

# Supply operator-reviewed build profiles with immutable image digests.
# Empty profiles allow installation diagnostics, but block software delivery.
FACTORY_BUILD_PROFILES_JSON='{}'
FACTORY_REPOSITORY_PROFILES_JSON='{}'
FACTORY_APPROVED_SCM_HOSTS_JSON='["github.com"]'
FACTORY_SANDBOX_NETWORK_ENABLED=false
FACTORY_FAILURE_RETENTION_SECONDS=86400
FACTORY_SUCCESS_RETENTION_SECONDS=0
