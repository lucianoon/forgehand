# Não há senha padrão. Preencha as duas configurações antes de executar Compose.
POSTGRES_PASSWORD=
# Use a mesma senha acima, percent-encoded na URL quando necessário.
DATABASE_URL=
APP_ENV=production
APP_ORIGIN=https://seu-dominio.example
# Teste LOCAL: APP_ENV=development e APP_ORIGIN=http://127.0.0.1:8000
# URL Compose: postgresql://product:SENHA_URL_ENCODED@db:5432/product
