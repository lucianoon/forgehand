# Runtime
ENVIRONMENT=dev
APP_PORT=8000
LLM_PROVIDER_BACKEND=openrouter
# For direct OpenAI: LLM_PROVIDER_BACKEND=openai, then load the ignored
# .env.local securely using uvicorn --env-file .env.local (see docs/openai.md).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_APP_NAME=forgehand
ANTHROPIC_API_KEY=

# Troque a chave antes de qualquer ambiente compartilhado.
API_KEYS_JSON='{"dev-key":{"client_id":"dev-client","projects":["*"],"role":"admin"}}'

# Persistência e workers
DATABASE_URL=postgresql://forge:forge@postgres:5432/forgehand
CHECKPOINTER_BACKEND=postgres
WORKFLOW_QUEUE_BACKEND=postgres
RUN_EMBEDDED_WORKFLOW_WORKERS=false
WORKFLOW_WORKER_CONCURRENCY=2

# Memória de projeto (Fase 4): memory | neo4j
# Com neo4j: docker compose --profile neo4j up (e defina NEO4J_PASSWORD)
MEMORY_BACKEND=memory
NEO4J_URI=bolt://neo4j:7687
NEO4J_PASSWORD=

# Tracing (Fase 7): none | otlp. O exporter lê as variáveis padrão do OTel.
# Para Langfuse, aponte o endpoint OTLP e use Basic auth com pk:sk em base64.
TRACING_BACKEND=none
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk-lf-...:sk-lf-...)>

# Auditoria e integrações
AUDIT_LOG_BACKEND=jsonl
AUDIT_LOG_PATH=/srv/forgehand/data/audit.jsonl
WEBHOOK_URLS_JSON=[]
WEBHOOK_SIGNING_SECRET=
GITHUB_TOKEN=

# Execução segura de validações (opt-in)
EXECUTOR_APPLY_FILES_ENABLED=false
EXECUTOR_COMMAND_BACKEND=docker
EXECUTOR_SANDBOX_NETWORK_ENABLED=false
