# Perfil de demonstração local: sem Postgres, Neo4j ou Docker.
#
#   make demo
#   # ou, sem make (ex.: Windows):
#   uv run uvicorn app.main:app --env-file .env.demo
#
# Abra http://localhost:8000/dashboard e use a chave local "dev-key".
# Abrir e validar o mission control não consome tokens; executar um
# workflow exige um provider real (veja o final deste arquivo).

ENVIRONMENT=dev

# Tudo em memória: o estado vive apenas enquanto o processo roda.
CHECKPOINTER_BACKEND=memory
WORKFLOW_QUEUE_BACKEND=memory
MEMORY_BACKEND=memory
AUDIT_LOG_BACKEND=memory
TRACING_BACKEND=none

# Fila em memória exige workers embutidos no processo da API.
RUN_EMBEDDED_WORKFLOW_WORKERS=true
WORKFLOW_WORKER_CONCURRENCY=2

# Comandos de validação objetiva rodam no host, sem Docker.
EXECUTOR_COMMAND_BACKEND=local

# Workspace dedicado: planner, executor e judge exploram (e, se habilitado,
# escrevem) só aqui — nunca no diretório do servidor.
EXECUTOR_WORKSPACE_ROOT=./data/demo-workspace
REPOSITORY_ROOT=./data/demo-workspace

# Chave local de desenvolvimento (igual ao default do código, explícita aqui).
API_KEYS_JSON='{"dev-key":{"client_id":"dev-client","projects":["*"],"role":"admin"}}'

# Para executar workflows de verdade, preencha um provider:
# LLM_PROVIDER_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# ou
# LLM_PROVIDER_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
